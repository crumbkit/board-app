#!/usr/bin/env bash
# Installs the Board release this directory holds. INSTALL.md says what it
# changes and when to run it.
#
#   install            board, attention-sign, the skills and plugin schemas
#   install --hooks    also Board's Claude Code mods; ask the owner first
#
# Board.app runs install --hooks and reads these lines on standard output
# to show progress. Every other line is for a person.
#
#   ::step <n> <label>      step n starts
#   ::done <n> <summary>    step n finished
#   ::warn <n> <summary>    step n finished and left something for the person
#   ::controls <path>       a known board still names the controls plugin
#   ::path <path>           the path that the refusal on standard error names
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
share="$HOME/.local/share/board"
bin="$HOME/.local/bin"
skills="$HOME/.claude/skills"
config="$HOME/.config/board/config.json"
hooks=false
case "${1:-}" in
  "") ;;
  --hooks) hooks=true ;;
  *)
    echo "install: unknown argument $1; run install or install --hooks." >&2
    exit 2
    ;;
esac

current_step=0
step() {
  current_step=$1
  echo "::step $1 $2"
}
finished() { echo "::done $current_step $1"; }
warn() { echo "::warn $current_step $1"; }
# Stops the install. The first argument is the path the refusal is about,
# or empty.
refuse() {
  if [ -n "$1" ]; then echo "::path $1"; fi
  echo "::refusal $2"
  echo "install: $2" >&2
  exit 1
}
# Prints each item of a JSON array at a key path, one per line, with plutil,
# which every Mac has. A missing file or key prints nothing.
json_list() {
  local count i
  count=$(plutil -extract "$2" raw -o - "$1" 2>/dev/null) || return 0
  for ((i = 0; i < count; i++)); do plutil -extract "$2.$i" raw -o - "$1"; done
}
# True when a link is one an installer of Board made: into a copied release,
# or to a board-attention checkout, which is the Python attention plugin.
board_link() {
  local target
  target=$(readlink "$1")
  case "$target" in
    "$share/current/"* | "$share/releases/"*) return 0 ;;
  esac
  [ -f "$target/pyproject.toml" ] && grep -qx 'name = "board-attention"' "$target/pyproject.toml"
}

# 1. Check everything before changing anything, so a refusal leaves the old
# install whole.
step 1 "Check this Mac"
case ":$PATH:" in
  *":$bin:"*) ;;
  *) refuse "$bin" "$bin is not on PATH, so the board it installs would not run. Add it to PATH, then try again." ;;
esac
id=$(plutil -extract id raw -o - "$here/release.json")
release="$share/releases/$id"
if [ -e "$share/current" ] && [ ! -L "$share/current" ]; then
  refuse "$share/current" "$share/current is not a link the installer made. Move it aside, then try again."
fi
# The Python attention plugin's links. Board has attention built in and
# refuses its calls while the old plugin is linked.
for path in "$share/plugins/attention" "$skills/attention"; do
  if [ -L "$path" ]; then
    board_link "$path" \
      || refuse "$path" "$path is a link to $(readlink "$path"), which is not the old attention plugin. Move it aside, then try again."
  elif [ -e "$path" ] && [ "$path" = "$share/plugins/attention" ]; then
    refuse "$path" "$path is a folder, not a link the installer made. Move it aside, then try again."
  fi
done
# A board with no skills would make board skills install remove every
# skill an older board wrote.
probe=$(mktemp -d)
shipped=$("$here/bin/board" skills list --dir "$probe" --fields name </dev/null 2>/dev/null | tail -n +2 | wc -l) || shipped=0
rm -rf -- "$probe"
if [ "$shipped" -eq 0 ]; then
  refuse "$here/bin/board" "$here/bin/board ships no skills, so this release is broken. Install a release built again with bin/bundle."
fi
# Another board earlier on PATH would still run in place of the new one.
IFS=: read -r -a entries <<<"$PATH"
for dir in "${entries[@]}"; do
  [ "$dir" = "$bin" ] && break
  if [ -n "$dir" ] && [ -f "$dir/board" ] && [ -x "$dir/board" ]; then
    refuse "$dir/board" "$dir/board comes before $bin/board on PATH, so the old board would still run. Remove it, or put $bin first, then try again."
  fi
done
# board skills install refuses a folder at a skill's name that it did not
# write. A link an older release made is removed in step 4, so it passes.
while read -r state name _; do
  [ "$state" = not_board ] || continue
  if [ -L "$skills/$name" ] && board_link "$skills/$name"; then continue; fi
  refuse "$skills/$name" "$skills/$name is not a skill board wrote, and board writes a skill of that name. Move it aside, then try again."
done < <("$here/bin/board" skills list --dir "$skills" --fields state,name </dev/null 2>/dev/null | tail -n +2)
echo "Checked $bin is on PATH, no other board comes first, and every link and skill folder is one Board made."
finished "Checked this Mac"

# 2. Copy the release once. Nothing writes in it afterwards.
step 2 "Copy the release"
mkdir -p "$share/releases" "$bin"
if [ ! -d "$release" ]; then
  partial="$share/releases/.partial-$id"
  rm -rf -- "$partial"
  cp -R "$here" "$partial"
  mv "$partial" "$release"
  echo "Copied release $id."
else
  echo "Release $id is already copied."
fi
finished "Copied the release"

# 3. Replace the binaries, keeping each old one as <name>.prev beside the
# board data. Then remove the plugin links an older release made, since every
# plugin is built into the new board.
step 3 "Install board and attention-sign"
for name in board attention-sign; do
  if [ -f "$bin/$name" ] && ! cmp -s "$bin/$name" "$release/bin/$name"; then
    cp -p "$bin/$name" "$share/$name.prev"
    echo "Kept the old $name as $share/$name.prev."
  fi
  install -m 755 "$release/bin/$name" "$bin/.$name.new"
  mv -f "$bin/.$name.new" "$bin/$name"
done
echo "Installed board and attention-sign in $bin."
for path in "$share"/plugins/*; do
  if [ -L "$path" ] && board_link "$path"; then
    rm -- "$path"
    echo "Removed $path, since board has the plugin built in."
  fi
done
finished "Installed board and attention-sign"

# 4. The skills that match the new board. A link an older release made would
# stop board writing the skill of the same name, so the links go first.
step 4 "Install skills"
mkdir -p "$skills"
for path in "$skills"/*; do
  if [ -L "$path" ] && board_link "$path"; then
    rm -- "$path"
    echo "Removed $path, which board now writes itself."
  fi
done
written=$("$bin/board" skills install --all --fields state,name </dev/null) \
  || refuse "" "board skills install refused, so the skills are still the old ones. Fix what its error says, then try again."
echo "$written"
finished "Installed $(awk 'NR > 1 && $1 == "written"' <<<"$written" | wc -l | tr -d ' ') skills"

# 5. Enable every built-in plugin in the personal board, and enable again
# the built-in plugins each other known board enables, which refreshes their
# schemas. Each change is a commit. A board that still names controls is
# left as it is, since MIGRATING.md moves it to rules by hand.
step 5 "Enable plugins in your boards"
# A relative path in Board's config is read against the config's folder, as
# board reads it.
absolute() {
  case "$1" in
    /*) echo "$1" ;;
    *) echo "$(dirname "$config")/$1" ;;
  esac
}
boards=()
personal=
if [ -f "$config" ]; then
  personal=$(plutil -extract personal raw -o - "$config" 2>/dev/null || true)
  if [ -n "$personal" ]; then
    personal=$(absolute "$personal")
    boards+=("$personal")
  fi
  while IFS= read -r board; do
    [ -n "$board" ] || continue
    board=$(absolute "$board")
    if [ "$board" != "$personal" ]; then boards+=("$board"); fi
  done < <(json_list "$config" boards)
fi
if [ ${#boards[@]} -gt 0 ]; then
  enabled_in=0
  failed=()
  errors=$(mktemp)
  for board in ${boards[@]+"${boards[@]}"}; do
    named=$(json_list "$board/.board/board.json" plugins)
    if grep -qx controls <<<"$named"; then
      echo "::controls $board"
      echo "$board still names the controls plugin, so its plugins were left as they are. MIGRATING.md says how to move it to rules."
      continue
    fi
    # plugin list exits 1 when a plugin from elsewhere reports a problem,
    # and still lists every plugin.
    plugins=$("$bin/board" -C "$board" plugin list --fields name,enabled,status --all 2>"$errors" </dev/null) || true
    if [ -z "$plugins" ]; then
      echo "$board: $(cat "$errors")" >&2
      failed+=("$board")
      continue
    fi
    while read -r name enabled _ code; do
      # A plugin under $share/plugins comes from elsewhere, not from this
      # release, so the installer leaves it to its owner. A plugin the
      # board names that board does not have cannot be enabled.
      [ ! -e "$share/plugins/$name" ] && [ ! -L "$share/plugins/$name" ] || continue
      [ "$code" != board::plugin::not_installed ] || continue
      [ "$board" = "$personal" ] || [ "$enabled" = true ] || continue
      if out=$("$bin/board" -C "$board" plugin enable "$name" 2>&1 </dev/null); then
        sed "s|^|$board: |" <<<"$out"
      else
        echo "$board: $out" >&2
        failed+=("$name in $board")
      fi
    done < <(tail -n +2 <<<"$plugins")
    enabled_in=$((enabled_in + 1))
  done
  rm -f -- "$errors"
  if [ ${#failed[@]} -gt 0 ]; then
    refuse "" "these were not enabled: ${failed[*]}. Fix what each error says, then try again."
  fi
  if [ $enabled_in -eq 1 ]; then finished "Enabled plugins in 1 board"; else finished "Enabled plugins in $enabled_in boards"; fi
else
  echo "$config names no board, so no board's plugins were enabled."
  warn "Enabled no plugins, because $config does not name a personal board"
fi

# 6. Board's Claude Code mods, from one marketplace named board in the copied
# release. Adding it again re-points a marketplace of that name and keeps
# its installed mods; removing it would uninstall them and delete their
# data. The new mods go in before the old ones come out.
if $hooks; then
  step 6 "Install Claude Code mods"
  if ! command -v claude >/dev/null; then
    echo "claude is not on PATH, so no Claude Code mods were installed."
    warn "Installed no Claude Code mods, because claude is not on PATH"
  else
    count=$(plutil -extract plugins raw -o - "$release/.claude-plugin/marketplace.json")
    mods=()
    for ((i = 0; i < count; i++)); do
      mods+=("$(plutil -extract "plugins.$i.name" raw -o - "$release/.claude-plugin/marketplace.json")")
    done
    marketplaces=$(claude plugin marketplace list --json </dev/null)
    claude plugin marketplace add "$release" </dev/null \
      || refuse "" "Claude Code did not add the board marketplace from $release. Fix what its error says, then try again."
    for name in ${mods[@]+"${mods[@]}"}; do
      claude plugin install "$name@board" </dev/null \
        || refuse "" "Claude Code did not install $name@board. Fix what its error says, then try again."
      claude plugin update "$name@board" </dev/null \
        || refuse "" "Claude Code did not update $name@board. Fix what its error says, then try again."
    done
    echo "Installed the Claude Code mods ${mods[*]}. They load in sessions started from now on."
    finished "Installed ${#mods[@]} Claude Code mods"

    # 7. The mods the new ones replace: board-controls is now board-rules,
    # and attention-approve, from the attention marketplace on GitHub, is
    # now board-attention.
    step 7 "Remove board-controls and attention-approve"
    installed=$(claude plugin list --json </dev/null)
    removed=()
    left=()
    for mod in board-controls@board attention-approve@attention; do
      grep -qF "\"$mod\"" <<<"$installed" || continue
      if claude plugin uninstall "$mod" </dev/null; then
        removed+=("${mod%@*}")
      else
        left+=("$mod")
      fi
    done
    if grep -q '"name": *"attention"' <<<"$marketplaces"; then
      claude plugin marketplace remove attention </dev/null || left+=("the attention marketplace")
    fi
    if [ ${#left[@]} -gt 0 ]; then
      echo "Claude Code did not remove ${left[*]}. Remove each with claude plugin uninstall."
      warn "Did not remove ${left[*]}; remove each with claude plugin uninstall"
    elif [ ${#removed[@]} -eq 2 ]; then
      finished "Removed ${removed[0]} and ${removed[1]}"
    elif [ ${#removed[@]} -eq 1 ]; then
      finished "Removed ${removed[0]}"
    else
      finished "Found no old mods to remove"
    fi
  fi
fi

# current names the installed release. It moves only when every step is
# done, so an install that stopped is offered again.
ln -sfn "releases/$id" "$share/current"
echo "Board release $id is installed."
