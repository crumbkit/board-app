#!/bin/sh
# The owner runs this, never an agent. Builds the iPhone app signed for
# development, then installs and opens it on a phone connected to this Mac. Xcode must be signed in to the team in
# project.yml; the first run registers the phone with that team.
#
#   bin/install-phone [<udid>]   with no udid, the one connected iPhone or iPad
set -eu
cd "$(dirname "$0")/.."
bin/project

udid=${1:-}
if [ -z "$udid" ]; then
  json=$(mktemp)
  xcrun devicectl list devices --quiet --json-output "$json" >/dev/null
  udid=$(python3 - "$json" <<'PY'
import json, sys
devices = json.load(open(sys.argv[1]))["result"]["devices"]
found = [d["hardwareProperties"]["udid"] for d in devices
         if d["hardwareProperties"].get("platform") == "iOS"
         and d.get("connectionProperties", {}).get("pairingState") == "paired"]
print(found[0] if len(found) == 1 else "")
PY
  )
  rm "$json"
  if [ -z "$udid" ]; then
    echo "bin/install-phone: found no single paired iPhone or iPad; connect one, or pass its udid from: xcrun devicectl list devices" >&2
    exit 1
  fi
fi

out=.build/xcode
xcodebuild -project Board.xcodeproj -scheme Board-iOS -configuration Debug \
  -destination "id=$udid" -derivedDataPath "$out" \
  -allowProvisioningUpdates -allowProvisioningDeviceRegistration -quiet build
xcrun devicectl device install app --device "$udid" "$out/Build/Products/Debug-iphoneos/Board.app"
xcrun devicectl device process launch --device "$udid" com.stemmacorp.board
