#!/bin/sh
# The owner runs this, never an agent. Archives the iPhone app for the App
# Store and uploads it to App Store Connect, where it reaches TestFlight once
# Apple has processed it. Xcode must be signed in to an account that may
# upload for the team in project.yml, and App Store Connect must have an app
# with bundle id com.stemmacorp.board.
#
#   bin/testflight
set -eu
cd "$(dirname "$0")/.."
bin/project

out=.build/testflight
rm -rf "$out"
mkdir -p "$out"
# Each upload needs a build number higher than the last. Two parts keep each
# number small.
build=$(date -u +%Y%m%d.%H%M)
xcodebuild -project Board.xcodeproj -scheme Board-iOS -configuration Release \
  -destination generic/platform=iOS -archivePath "$out/Board.xcarchive" \
  -allowProvisioningUpdates CURRENT_PROJECT_VERSION="$build" -quiet archive

cat > "$out/ExportOptions.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>method</key><string>app-store-connect</string>
  <key>destination</key><string>upload</string>
  <key>teamID</key><string>78HLU526FA</string>
  <key>signingStyle</key><string>automatic</string>
  <key>manageAppVersionAndBuildNumber</key><false/>
</dict>
</plist>
PLIST
xcodebuild -exportArchive -archivePath "$out/Board.xcarchive" \
  -exportOptionsPlist "$out/ExportOptions.plist" -exportPath "$out/export" \
  -allowProvisioningUpdates
echo "Uploaded build $build. It appears in TestFlight once App Store Connect has processed it."
