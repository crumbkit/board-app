#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# ──────────────────────────────────────────────────────────────────────────

cd "$(dirname "$0")/.."

# add_line FILE KEY LINE: drops the lines of FILE that contain KEY and appends
# LINE. It writes through a symlink to its target and keeps an existing mode.
add_line() {
  local target mode tmp
  target=$(realpath "$1" 2>/dev/null || printf '%s' "$1")
  mode=$(stat -f %Lp "$target" 2>/dev/null || echo 644)
  if (( 8#$mode & 8#022 )); then
    warn "$target may be written by other users, so Board would not trust it. Run: chmod go-w $target"
    return 1
  fi
  mkdir -p "$(dirname "$target")"
  tmp=$(mktemp "$(dirname "$target")/.allowed_signers.XXXXXX")
  trap 'rm -f "$tmp"' RETURN
  if [ -e "$target" ]; then grep -vF -- "$2" "$target" > "$tmp" || [ $? -eq 1 ]; fi
  printf '%s\n' "$3" >> "$tmp"
  chmod "$mode" "$tmp"
  mv "$tmp" "$target"
}
TOTAL_STAGES=9

banner "Board on your iPhone and Mac"

stage "Accept the Xcode licence"
say "Xcode updated to 27.1, and every Xcode tool waits until its licence is accepted."
say "These two commands need your Mac password: they accept the licence and install"
say "the components Xcode needs on first launch."
note "sudo xcodebuild -license accept"
note "sudo xcodebuild -runFirstLaunch"
if xcodebuild -license check >/dev/null 2>&1 && xcodebuild -checkFirstLaunchStatus >/dev/null 2>&1; then
  say "The licence is already accepted."
elif confirm "Run them now?"; then
  sudo xcodebuild -license accept
  sudo xcodebuild -runFirstLaunch
else
  SKIPPED+=("accept the Xcode licence: sudo xcodebuild -license accept")
fi
pause

stage "Install XcodeGen"
say "The Xcode project is generated from project.yml by XcodeGen."
if command -v xcodegen >/dev/null 2>&1; then
  say "XcodeGen is already installed."
else
  brew install xcodegen
fi
pause

stage "Sign Xcode in to your developer team"
say "Xcode signs the apps for team 78HLU526FA, the team of your Developer ID certificate."
open -a Xcode
step "In Xcode, choose Xcode ▸ Settings… ▸ Accounts."
step "Click + ▸ Apple Account, and sign in with the Apple Account of that team."
step "Check that the team appears in the list for that account."
pause "Press Enter once the team is listed."

stage "Check iCloud on both devices"
say "The phone and the Mac find each other through your private iCloud database."
step "On the Mac: System Settings ▸ your name at the top. Note the Apple Account."
step "On the iPhone: Settings ▸ your name at the top. It must be the same account."
pause "Press Enter once both are signed in to the same account."

stage "Connect the iPhone"
step "Connect the iPhone to this Mac with a cable, and unlock it."
step "If the iPhone asks whether to trust this computer, tap Trust and enter its passcode."
say "Waiting for the iPhone to appear…"
until xcrun devicectl list devices 2>/dev/null | grep -qiE 'iphone|ipad'; do sleep 2; done
xcrun devicectl list devices 2>/dev/null | grep -iE 'name|iphone|ipad'
step "On the iPhone: Settings ▸ Privacy & Security ▸ Developer Mode. Turn it on."
step "The iPhone restarts. After it restarts, unlock it and tap Turn On."
note "Developer Mode appears in Settings only after the iPhone has been connected to Xcode."
pause "Press Enter once Developer Mode is on and the iPhone is unlocked."

stage "Install Board on the iPhone"
say "This builds the app, registers the iPhone with your team, and installs it."
note "bin/install-phone"
until bin/install-phone; do
  warn "The install failed. The message above says why."
  note "A locked iPhone, Developer Mode still off, or Xcode not signed in are the usual causes."
  confirm "Try again?" || { SKIPPED+=("install on the iPhone: bin/install-phone"); break; }
done
say "Board should now be open on the iPhone, showing \"Connecting to your Mac\"."
pause

stage "Install Board on the Mac"
dest="$HOME/Applications/Board.app"
id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$dest/Contents/Info.plist" 2>/dev/null || true)
replace=""
if [ -n "$id" ] && [ "$id" != com.stemmacorp.board ]; then
  warn "$dest is another app ($id)."
  [ "$id" = com.stemmacorp.flightcard ] && [ -e "$HOME/Applications/Flightcard.app" ] \
    && say "It is an old Flightcard build, and Flightcard.app is installed beside it."
  if confirm "Move the old copy to the Trash and install Board in its place?"; then
    replace=--replace
  else
    SKIPPED+=("install on the Mac: bin/install-mac --replace")
  fi
fi
if [ -z "$id" ] || [ "$id" = com.stemmacorp.board ] || [ -n "$replace" ]; then
  until bin/install-mac $replace; do
    warn "The install failed. The message above says why."
    confirm "Try again?" || { SKIPPED+=("install on the Mac: bin/install-mac"); break; }
  done
fi
pause

stage "Let this Mac's key sign for Board"
board_signers="$HOME/.config/board/allowed_signers"
if ! command -v attention-sign >/dev/null 2>&1; then
  warn "attention-sign is not on your PATH, so this Mac's key cannot be read."
  SKIPPED+=("add this Mac's key to $board_signers once attention-sign is installed")
elif [ -e "$board_signers" ] && [ ! -r "$board_signers" ]; then
  warn "$board_signers cannot be read, so it was left as it is."
  SKIPPED+=("make $board_signers readable, then run bin/setup again")
elif ! mac_key=$(attention-sign key) || [ -z "$mac_key" ]; then
  warn "attention-sign could not print this Mac's key."
  SKIPPED+=("add this Mac's key to $board_signers: attention-sign key failed")
else
  mac_line="owner namespaces=\"board/approve/v1,board/write/v1\" $mac_key"
  say "Board checks approvals and rule changes against $board_signers."
  say "This Mac's Touch ID key needs this line there (the key is cut short here):"
  note "${mac_line:0:90}…"
  if grep -qxF "$mac_line" "$board_signers" 2>/dev/null; then
    say "The line is already there."
  elif confirm "Add it, replacing any older line for this Mac's key?"; then
    if add_line "$board_signers" " ${mac_key#* }" "$mac_line"; then
      say "Added. Lines for other devices were kept."
    else
      SKIPPED+=("add this Mac's key to $board_signers")
    fi
  else
    SKIPPED+=("add this Mac's key to $board_signers")
  fi
fi
pause

stage "Pair the iPhone"
say "The Mac window shows \"Add <your iPhone>\" with six digits, and the iPhone shows six digits."
step "Check that the digits match. If they don't, click Cancel on the Mac."
step "Choose what the iPhone may approve, then click Add with Touch ID."
step "The iPhone then shows \"You're set\"."
pause "Press Enter once the iPhone shows \"You're set\"."
say "The iPhone's lines in your allowed signers files:"
grep -h "board-app/device/" ~/.config/board/allowed_signers ~/.config/attention/allowed_signers 2>/dev/null \
  | cut -c1-90 || warn "No paired iPhone is listed yet."

finish
