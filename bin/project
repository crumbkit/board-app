#!/bin/sh
# Generates Board.xcodeproj from project.yml, and Bundle.yml when there is a
# release to ship, with XcodeGen.
set -eu
cd "$(dirname "$0")/.."
command -v xcodegen >/dev/null || {
  echo "bin/project: xcodegen is not installed; run: brew install xcodegen" >&2
  exit 1
}
# The Mac app ships Bundle/board when bin/bundle has written it. Without it,
# Bundle.yml is left out and the app ships no Board release.
if [ -d Bundle/board ]; then BOARD_BUNDLE=true; else BOARD_BUNDLE=false; fi
export BOARD_BUNDLE
xcodegen generate --quiet
